<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Serilog Sink for Azure Log Analytics</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>A Serilog Sink for Azure Log Analytics that u the Log Ingestion API</Description>
    <Copyright>Cam Bruce</Copyright>
    <PackageProjectUrl>https://github.com/cbruce80/serilog.sinks.azure.log-analytics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cbruce80/serilog.sinks.azure.log-analytics</RepositoryUrl>
    <PackageTags>serilog;log analytics;azure</PackageTags>
    <PackageReleaseNotes>Initial Release</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
  
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
<PropertyGroup>
  <Version>1.2.0</Version>
  <PackageReleaseNotes>
    - Added support for .NET 10.0.
    - Updated to Serilog 4
    - Updated Azure Identity dependency to 1.13.2.
    - Removed Newtonsoft dependency, switching to System.Text
    - Utilze the PeriodicBatching interface
    - Improved log ingestion retry logic.
  </PackageReleaseNotes>
  
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Azure.Monitor.Ingestion" Version="1.2.0" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Configuration\" />
  </ItemGroup>

</Project>
