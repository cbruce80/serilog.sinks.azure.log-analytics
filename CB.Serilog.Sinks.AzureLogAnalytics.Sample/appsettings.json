{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.AzureLogAnalytics"
    ],
    "MinimumLevel": "Verbose",
    "WriteTo": [
      {
        "Name": "AzureLogAnalytics",
        "Args": {
          "DataCollectionEndpointUri": "<data-collection-endpoint>",
          "RuleId": "<rule-id>",
          "StreamName": "<stream-name>",
          "OutputToConsole": true,
          "MaxLogEntries": 5
        }
      }
    ]
  }
}